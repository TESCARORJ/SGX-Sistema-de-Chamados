{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API - Debug Local (sem build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/SGX.SistemaChamado.Api/bin/Debug/net9.0/SGX.SistemaChamado.Api.dll",
      "cwd": "${workspaceFolder}/src/SGX.SistemaChamado.Api",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Authentication__ModoLocalHabilitado": "true",
        "ASPNETCORE_URLS": "http://localhost:5168"
      }
    },
    {
      "name": "API - Debug Local (com build seguro)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build api",
      "program": "${workspaceFolder}/src/SGX.SistemaChamado.Api/bin/Debug/net9.0/SGX.SistemaChamado.Api.dll",
      "cwd": "${workspaceFolder}/src/SGX.SistemaChamado.Api",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Authentication__ModoLocalHabilitado": "true",
        "ASPNETCORE_URLS": "http://localhost:5168"
      }
    },
    {
      "name": "Worker Email - Debug Local (sem build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/SGX.SistemaChamado.Worker.Email/bin/Debug/net9.0/SGX.SistemaChamado.Worker.Email.dll",
      "cwd": "${workspaceFolder}/src/SGX.SistemaChamado.Worker.Email",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Worker Email - Debug Local (com build seguro)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build worker",
      "program": "${workspaceFolder}/src/SGX.SistemaChamado.Worker.Email/bin/Debug/net9.0/SGX.SistemaChamado.Worker.Email.dll",
      "cwd": "${workspaceFolder}/src/SGX.SistemaChamado.Worker.Email",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Web - Run Local",
      "type": "node-terminal",
      "request": "launch",
      "command": "./scripts/start-web.sh",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "API + Web - Local",
      "configurations": [
        "API - Debug Local (sem build)",
        "Web - Run Local"
      ]
    },
    {
      "name": "API + Worker - Local",
      "configurations": [
        "API - Debug Local (sem build)",
        "Worker Email - Debug Local (sem build)"
      ]
    }
  ]
}
