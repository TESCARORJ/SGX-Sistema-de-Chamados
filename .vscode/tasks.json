{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet: restore",
      "type": "shell",
      "command": "dotnet restore SGX.SistemaChamado.sln",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "dotnet: build solution",
      "type": "shell",
      "command": "dotnet build SGX.SistemaChamado.sln",
      "dependsOn": [
        "dotnet: restore"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "dotnet: test solution",
      "type": "shell",
      "command": "dotnet test SGX.SistemaChamado.sln",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "dotnet: run api",
      "type": "shell",
      "command": "dotnet run --project src/SGX.SistemaChamado.Api/SGX.SistemaChamado.Api.csproj",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "Authentication__ModoLocalHabilitado": "true",
          "ASPNETCORE_URLS": "http://localhost:5168"
        }
      },
      "problemMatcher": [
        {
          "owner": "custom",
          "pattern": {
            "regexp": "^(.*)$",
            "file": 1,
            "location": 1,
            "message": 1
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^.*$",
            "endsPattern": "Now listening on:|Application started\\."
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "dotnet: run worker-email",
      "type": "shell",
      "command": "dotnet run --project src/SGX.SistemaChamado.Worker.Email/SGX.SistemaChamado.Worker.Email.csproj",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DOTNET_ENVIRONMENT": "Development",
          "ASPNETCORE_ENVIRONMENT": "Development",
          "Authentication__ModoLocalHabilitado": "true",
          "EmailWorker__ImapHost": "",
          "EmailWorker__Senha": "",
          "EmailWorker__IntervaloSegundos": "30",
          "EmailWorker__MaxMensagensPorCiclo": "10"
        }
      },
      "problemMatcher": [
        {
          "owner": "custom",
          "pattern": {
            "regexp": "^(.*)$",
            "file": 1,
            "location": 1,
            "message": 1
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^.*$",
            "endsPattern": "Application started\\.|Worker.*iniciado|Service started|Starting"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "npm: install web",
      "type": "shell",
      "command": "npm.cmd install",
      "options": {
        "cwd": "${workspaceFolder}/src/SGX.SistemaChamado.Web"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "npm: dev web",
      "type": "shell",
      "command": "npm.cmd run dev",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/src/SGX.SistemaChamado.Web",
        "env": {
          "VITE_API_BASE_URL": "http://localhost:5168",
          "VITE_AUTH_MODO_LOCAL": "true"
        }
      },
      "problemMatcher": [
        {
          "owner": "custom",
          "pattern": {
            "regexp": "^(.*)$",
            "file": 1,
            "location": 1,
            "message": 1
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^.*$",
            "endsPattern": "Local:\\s+http://localhost:5173/|ready in"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "npm: build web",
      "type": "shell",
      "command": "npm.cmd run build",
      "options": {
        "cwd": "${workspaceFolder}/src/SGX.SistemaChamado.Web"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "ef: database update",
      "type": "shell",
      "command": "dotnet tool run dotnet-ef database update --project src/SGX.SistemaChamado.Infrastructure --startup-project src/SGX.SistemaChamado.Api",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "app: run api + web",
      "dependsOrder": "parallel",
      "dependsOn": [
        "dotnet: run api",
        "npm: dev web"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
