{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet: build api",
      "type": "shell",
      "command": "dotnet build src/SGX.SistemaChamado.Api/SGX.SistemaChamado.Api.csproj /p:UseSharedCompilation=false /nr:false -m:1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "dotnet: build worker",
      "type": "shell",
      "command": "dotnet build src/SGX.SistemaChamado.Worker.Email/SGX.SistemaChamado.Worker.Email.csproj /p:UseSharedCompilation=false /nr:false -m:1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "db: update",
      "type": "shell",
      "command": "./scripts/db-update.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "web: dev",
      "type": "shell",
      "command": "./scripts/start-web.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
